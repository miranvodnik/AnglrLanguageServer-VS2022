<UserControl x:Class="AnglrLangExtension.AnglrPDASnapshotViewerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnglrLangExtension"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- DataGrid style -->
        <Style x:Key="PdaDataGridStyle" TargetType="{x:Type DataGrid}">
            <Setter Property="ColumnHeaderStyle" Value="{DynamicResource PdaColumnHeaderStyle}"/>
        </Style>
        <!-- DataGridColumnHeader style -->
        <Style x:Key="PdaColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#ffe6b3"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
    </UserControl.Resources>
    <Grid Grid.Column="0" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="100*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="pdaList" Grid.Row="0" Grid.Column="0"
            ItemsSource="{Binding PDAStackCells}"
            Style="{DynamicResource PdaDataGridStyle}"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            CanUserDeleteRows="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            CanUserReorderColumns="False"
            SelectionMode="Extended"
            SelectionUnit="FullRow"
            AlternationCount="2"
            RowBackground="#f2f2f2"
            AlternatingRowBackground="#e6e6e6"
            SelectionChanged="pdaList_SelectionChanged" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="State" Binding="{Binding State}" />
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Width="10" BorderThickness="1" Grid.Row="0" Grid.Column="1" Grid.RowSpan="1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#FFB4B4B4"/>
        <ScrollViewer
            Grid.Row="0" Grid.Column="2"
            HorizontalScrollBarVisibility="Visible"
            VerticalScrollBarVisibility="Visible"
            >
            <local:AnglrParserPartDrawingCanvas
                x:Name="pdaSnapshotVisual"
                Background="White"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                CanHorizontallyScroll="True"
                CanVerticallyScroll="True"
            />
        </ScrollViewer>
    </Grid>
</UserControl>
