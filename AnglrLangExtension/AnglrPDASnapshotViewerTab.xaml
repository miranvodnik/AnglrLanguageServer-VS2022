<UserControl x:Class="AnglrLangExtension.AnglrPDASnapshotViewerTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AnglrLangExtension"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="50*" />
        </Grid.ColumnDefinitions>
        <DataGrid x:Name="pdaList" Grid.Row="0" Grid.Column="0"
            ItemsSource="{Binding ParserStack}"
            AutoGenerateColumns="False"
            CanUserSortColumns="False"
            CanUserReorderColumns="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="State" Binding="{Binding}" />
                <DataGridTextColumn Header="Code" Binding="{Binding}" />
                <DataGridTextColumn Header="Name" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>
        <GridSplitter Width="10" BorderThickness="1" Grid.Row="0" Grid.Column="1" Grid.RowSpan="1" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="#FFB4B4B4"/>
        <ScrollViewer Grid.Row="0" Grid.Column="2" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" >
            <local:AnglrParserPartDrawingCanvas
                x:Name="pdaSnapshotVisual"
                Background="White"
                CanHorizontallyScroll="True"
                CanVerticallyScroll="True"
                Height="500"
            />
        </ScrollViewer>
    </Grid>
</UserControl>
